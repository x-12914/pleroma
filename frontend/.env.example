# AICDS Frontend - Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API Configuration
# Local Development
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (Render)
# VITE_API_BASE_URL=https://aicds-backend.onrender.com/api/v1

# For Vercel Deployment:
# 1. Go to Vercel Dashboard → Project Settings → Environment Variables
# 2. Add the VITE_API_BASE_URL variable with your production backend URL
# 3. Keep value same for: Production, Preview, Development
# 4. Redeploy the project
