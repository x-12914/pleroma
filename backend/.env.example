# AICDS Backend - Environment Variables
# Copy this file to .env and fill in your values

# ===== DATABASE CONFIGURATION =====
# Local Development (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aicds_db
# Production (Render): Auto-set via render.yaml

# ===== SECURITY =====
# Generate a random hex string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_random_hex_key

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== DEVELOPMENT =====
DEBUG=True

# ===== EXTERNAL API KEYS =====
# Get these from:
# - GROQ_API_KEY: https://console.groq.com (free tier available)
# - OPENROUTER_API_KEY: https://openrouter.ai (free credits)
# - SERPER_API_KEY: https://serper.dev (free tier available)
# - HF_API_KEY: https://huggingface.co (optional, for Hugging Face models)

GROQ_API_KEY=gsk_your_groq_key
HF_API_KEY=hf_your_huggingface_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
SERPER_API_KEY=your_serper_google_search_key

# ===== NETWORK MODEL (optional; sane defaults in config.py) =====
# See backend/app/services/network/README.md and deploy/CAPTURE.md.
# Where retrain.py reads base capture CSVs from:
NETWORK_BASE_DATASET_DIR=/opt/pleroma/ml/data/base
# Fraction of benign flows persisted at ingest for retraining (0-1), and cap:
BENIGN_SAMPLE_RATE=0.02
BENIGN_SAMPLE_CAP=20000
# Decision thresholds. Lower (more negative) ANOMALY flags fewer flows as
# "Anomaly-novel"; use backend/anomaly_report.py to choose from real data.
NETWORK_ANOMALY_THRESHOLD=-0.05
NETWORK_CONFIDENCE_THRESHOLD=0.60